---
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/Header.astro";
import LikeButton from "../components/LikeButton.astro";
import CommentSection from "../components/CommentSection.astro";

type Props = CollectionEntry<"blog">["data"] & { slug?: string; id?: string };

const { title, description, pubDate, updatedDate, heroImage, id, slug } =
	Astro.props;
const currentSlug = slug || id || Astro.url.pathname.split('/').filter(Boolean).pop() || "";
---

<html lang="ja">
	<head>
		<BaseHead title={title} description={description} />
		<style is:global>
			/* 記事本文内のHTML要素に対する厳密なタイポグラフィ指定 */
			.prose p {
				margin-bottom: 1.8rem;
				font-size: 16px;
				line-height: 2;
				color: rgba(234, 241, 248, 0.88);
			}
			.prose h2 {
				font-family: var(--font-display) !important;
				font-size: 24px !important;
				font-weight: 700 !important;
				color: var(--ink) !important;
				margin-top: 3.5rem !important;
				margin-bottom: 1.5rem !important;
				border-bottom: 1px solid rgba(255, 255, 255, 0.1) !important;
				padding-bottom: 0.5rem !important;
				letter-spacing: 0.05em !important;
			}
			.prose h3 {
				font-family: var(--font-display) !important;
				font-size: 20px !important;
				font-weight: 600 !important;
				color: var(--ink) !important;
				margin-top: 2.5rem !important;
				margin-bottom: 1rem !important;
				letter-spacing: 0.04em !important;
			}
			.prose ul,
			.prose ol {
				margin-bottom: 1.8rem;
				padding-left: 2rem;
			}
			.prose li {
				margin-bottom: 0.6rem;
				font-size: 16px;
				line-height: 1.8;
				color: rgba(234, 241, 248, 0.88);
			}
			.prose strong {
				color: var(--ink);
				font-weight: 700;
			}
			.prose blockquote {
				border-left: 4px solid var(--gray-label) !important;
				background: rgba(255, 255, 255, 0.03);
				padding: 1.2rem 1.5rem !important;
				margin: 2rem 0 !important;
				border-radius: 0 8px 8px 0;
			}
			.prose blockquote p {
				margin-bottom: 0;
				font-style: italic;
				color: var(--ink-sub);
			}
			.prose table {
				width: 100%;
				border-collapse: collapse;
				margin: 2rem 0;
				font-size: 14px;
			}
			.prose th,
			.prose td {
				border: 1px solid rgba(255, 255, 255, 0.1);
				padding: 0.75rem 1rem;
				text-align: left;
			}
			.prose th {
				background: rgba(255, 255, 255, 0.05);
				color: var(--ink);
				font-weight: 600;
			}
			.prose hr {
				border: none;
				border-top: 1px solid rgba(255, 255, 255, 0.1);
				margin: 3rem 0;
			}

			/* 酸素メーター */
			.o2-meter-container {
				position: fixed;
				right: 32px;
				bottom: 32px;
				width: 80px;
				height: 80px;
				background: rgba(10, 25, 47, 0.85);
				border: 1px solid rgba(255, 255, 255, 0.08);
				border-radius: 50%;
				display: flex;
				flex-direction: column;
				justify-content: center;
				align-items: center;
				z-index: 100;
				box-shadow:
					0 10px 25px rgba(0, 0, 0, 0.5),
					0 0 15px rgba(0, 240, 255, 0.03);
				backdrop-filter: blur(8px);
				-webkit-backdrop-filter: blur(8px);
				transition:
					border-color 0.3s ease,
					box-shadow 0.3s ease;
			}
			.o2-svg {
				position: absolute;
				top: 5px;
				left: 5px;
			}
			.o2-progress {
				transition:
					stroke-dashoffset 0.1s linear,
					stroke 0.3s ease;
			}
			.o2-text-wrapper {
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				position: relative;
				z-index: 2;
			}
			.o2-label {
				font-family: var(--font-mono);
				font-size: 10px;
				letter-spacing: 0.1em;
				color: var(--gray-label);
				line-height: 1;
				margin-bottom: 2px;
			}
			.o2-percent {
				font-family: var(--font-mono);
				font-size: 13px;
				font-weight: 700;
				color: var(--ink);
				line-height: 1;
			}
			/* 警告点滅 */
			@keyframes o2Blink {
				0% {
					opacity: 1;
					filter: drop-shadow(0 0 8px #ff0055);
				}
				50% {
					opacity: 0.5;
					filter: drop-shadow(0 0 1px #ff0055);
				}
				100% {
					opacity: 1;
					filter: drop-shadow(0 0 8px #ff0055);
				}
			}
			.o2-critical {
				border-color: #ff0055 !important;
				box-shadow: 0 0 20px rgba(255, 0, 85, 0.2) !important;
			}
			.o2-critical .o2-percent {
				color: #ff0055;
				animation: o2Blink 1s infinite ease-in-out;
			}
			@media (max-width: 720px) {
				.o2-meter-container {
					right: 16px;
					bottom: 16px;
					width: 70px;
					height: 70px;
				}
				.o2-svg {
					width: 60px;
					height: 60px;
					top: 5px;
					left: 5px;
				}
				.o2-percent {
					font-size: 11px;
				}
			}
		</style>
		<style>
			body {
				background-color: #001845; /* 漸深層 */
				color: var(--ink-body);
			}
			.marine-snow {
				position: fixed;
				top: 0;
				left: 0;
				width: 100vw;
				height: 100vh;
				pointer-events: none;
				z-index: 1;
				opacity: 0.4;
			}
			main {
				width: 100%;
				max-width: 860px;
				margin: 0 auto;
				padding: 120px 1.5rem 4rem 1.5rem; /* 固定ヘッダー分のパディングトップ */
				position: relative;
				z-index: 2;
			}
			article {
				background: rgba(15, 23, 42, 0.4);
				backdrop-filter: blur(16px);
				-webkit-backdrop-filter: blur(16px);
				border: 1px solid rgba(255, 255, 255, 0.08);
				border-radius: 16px;
				overflow: hidden;
				padding: 3rem;
				box-shadow: 0 20px 50px rgba(0, 0, 0, 0.3);
			}
			@media (max-width: 720px) {
				article {
					padding: 1.2rem;
					border-radius: 12px;
				}
				main {
					padding: 90px 0.5rem 3rem 0.5rem; /* モバイルでは外側の余白を減らし、記事の幅を最大化 */
				}
			}
			.hero-image {
				width: 100%;
				margin-bottom: 3rem;
				border-radius: 12px;
				overflow: hidden;
				border: 1px solid rgba(255, 255, 255, 0.08);
			}
			.hero-image img {
				display: block;
				width: 100%;
				height: auto;
				object-fit: cover;
			}
			.prose {
				width: 100%;
				max-width: 680px; /* 本文の横幅を読みやすい最適サイズに設定 */
				margin: 0 auto;
				font-family: var(--font-body);
			}
			.prose img {
				max-width: 100%;
				height: auto;
				border-radius: 8px;
			}
			.title {
				margin-bottom: 2.5rem;
				border-bottom: 1px solid rgba(255, 255, 255, 0.08);
				padding-bottom: 2rem;
			}
			.title h1 {
				font-family: var(--font-display);
				font-size: clamp(26px, 4.5vw, 38px);
				font-weight: 800;
				color: var(--ink);
				line-height: 1.35;
				margin-bottom: 0.75rem;
				letter-spacing: 0.03em;
			}
			.date {
				font-family: var(--font-mono);
				font-size: 12px;
				letter-spacing: 0.1em;
				color: var(--gray-label);
				margin-bottom: 1rem;
				display: flex;
				gap: 1rem;
			}
			.last-updated-on {
				font-style: italic;
				color: var(--gray-secondary);
			}
		</style>
	</head>

	<body>
		<Header />

		<canvas class="marine-snow" id="articleSnowCanvas"></canvas>

		<!-- 酸素メーター -->
		<div class="o2-meter-container" id="o2Meter" aria-label="酸素残量">
			<svg class="o2-svg" width="70" height="70" viewBox="0 0 70 70">
				<circle
					class="o2-track"
					cx="35"
					cy="35"
					r="28"
					fill="none"
					stroke="rgba(255,255,255,0.06)"
					stroke-width="4"></circle>
				<circle
					class="o2-progress"
					id="o2Circle"
					cx="35"
					cy="35"
					r="28"
					fill="none"
					stroke="#00f0ff"
					stroke-width="4"
					stroke-dasharray="175.92"
					stroke-dashoffset="0"
					transform="rotate(-90 35 35)"
					stroke-linecap="round"></circle>
			</svg>
			<div class="o2-text-wrapper">
				<span class="o2-label">O₂</span>
				<span class="o2-percent" id="o2Percent">100%</span>
			</div>
		</div>

		<main>
			<article>
				{
					heroImage && (
						<div class="hero-image">
							<img
								width="1020"
								height="510"
								src={heroImage}
								alt=""
							/>
						</div>
					)
				}
				<div class="prose">
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										(Last updated on{" "}
										<FormattedDate date={updatedDate} />)
									</div>
								)
							}
						</div>
						<h1>{title}</h1>
					</div>
					<slot />
					{
						currentSlug && (
							<>
								<LikeButton slug={currentSlug} />
								<CommentSection slug={currentSlug} />
							</>
						)
					}
				</div>
			</article>
		</main>
		<Footer />

		<script>
			const canvas = document.getElementById(
				"articleSnowCanvas",
			) as HTMLCanvasElement;
			const ctx = canvas ? canvas.getContext("2d") : null;
			const prefersReducedMotion = window.matchMedia(
				"(prefers-reduced-motion: reduce)",
			).matches;

			if (canvas && ctx && !prefersReducedMotion) {
				canvas.width = window.innerWidth;
				canvas.height = window.innerHeight;

				window.addEventListener("resize", () => {
					canvas.width = window.innerWidth;
					canvas.height = window.innerHeight;
				});

				const numParticles = 35;
				const particles = [];

				for (let i = 0; i < numParticles; i++) {
					particles.push({
						x: Math.random() * canvas.width,
						y: Math.random() * canvas.height,
						r: Math.random() * 1.5 + 0.5,
						d: Math.random() * numParticles,
						speedY: Math.random() * 0.3 + 0.1,
						speedX: Math.random() * 0.2 - 0.1,
					});
				}

				let angle = 0;
				function drawParticles() {
					ctx.clearRect(0, 0, canvas.width, canvas.height);
					ctx.fillStyle = "rgba(234, 241, 248, 0.25)";
					ctx.beginPath();

					for (let i = 0; i < numParticles; i++) {
						const p = particles[i];
						ctx.moveTo(p.x, p.y);
						ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2, true);

						p.y += p.speedY;
						p.x += Math.sin(angle + p.d) * 0.2 + p.speedX;

						if (p.y > canvas.height) {
							particles[i] = {
								x: Math.random() * canvas.width,
								y: -10,
								r: p.r,
								d: p.d,
								speedY: p.speedY,
								speedX: p.speedX,
							};
						}
					}
					ctx.fill();
					angle += 0.005;
					requestAnimationFrame(drawParticles);
				}

				drawParticles();
			}

			// 酸素メーター制御スクリプト
			const o2Meter = document.getElementById("o2Meter");
			const o2Circle = document.getElementById("o2Circle");
			const o2Percent = document.getElementById("o2Percent");

			if (o2Meter && o2Circle && o2Percent) {
				const maxOffset = 175.92; // 2 * PI * r (r=28)

				function updateO2Progress() {
					const scrollY = window.scrollY;
					const docHeight = document.documentElement.scrollHeight;
					const winHeight = window.innerHeight;
					const maxScroll = docHeight - winHeight;

					if (maxScroll <= 0) {
						o2Percent.textContent = "100%";
						o2Circle.style.strokeDashoffset = "0";
						o2Meter.classList.remove("o2-critical");
						return;
					}

					// 読み進めたパーセンテージ（0〜100）
					const scrollPercent = Math.min(
						100,
						Math.max(0, (scrollY / maxScroll) * 100),
					);
					// 酸素残量（100%から始まり、読み終わると0%になる）
					const o2Remaining = Math.round(100 - scrollPercent);

					o2Percent.textContent = `${o2Remaining}%`;

					// SVGゲージ更新
					const offset = maxOffset - (o2Remaining / 100) * maxOffset;
					o2Circle.style.strokeDashoffset = offset.toString();

					// 20%以下で警告クラス追加
					if (o2Remaining <= 20) {
						o2Meter.classList.add("o2-critical");
						o2Circle.style.stroke = "#ff0055";
					} else {
						o2Meter.classList.remove("o2-critical");
						o2Circle.style.stroke = "#00f0ff";
					}
				}

				window.addEventListener("scroll", updateO2Progress, {
					passive: true,
				});
				window.addEventListener("resize", updateO2Progress);
				updateO2Progress(); // 初期実行
			}
		</script>
	</body>
</html>
