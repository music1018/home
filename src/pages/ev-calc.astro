---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={`EV Calculator | ${SITE_TITLE}`} description="Tesla Model Y 電費計算・ガソリン車比較ツール" />
		<style>
			body {
				background-color: var(--bg-deep, #001233);
				color: var(--ink, #eaf1f8);
				margin: 0;
				font-family: var(--font-sans, system-ui, sans-serif);
			}

			main {
				margin-top: 70px; /* Header height */
				padding: 4rem 2rem;
				min-height: calc(100vh - 70px);
				display: flex;
				justify-content: center;
				align-items: flex-start;
				position: relative;
				z-index: 2;
			}

			.calc-container {
				max-width: 800px;
				width: 100%;
				background: rgba(255, 255, 255, 0.03);
				border: 1px solid rgba(255, 255, 255, 0.08);
				border-radius: 24px;
				padding: 3rem;
				backdrop-filter: blur(20px);
				-webkit-backdrop-filter: blur(20px);
				box-shadow: 0 30px 60px rgba(0, 0, 0, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.1);
			}

			.calc-header {
				margin-bottom: 3rem;
				text-align: center;
			}

			.calc-title {
				font-size: 2rem;
				font-family: var(--font-display, sans-serif);
				font-weight: 800;
				margin: 0 0 0.5rem 0;
				background: linear-gradient(135deg, #fff 0%, #a5b4fc 100%);
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
			}

			.calc-subtitle {
				color: var(--gray-label, #8ba3b8);
				font-size: 0.9rem;
				font-family: var(--font-mono, monospace);
				letter-spacing: 0.1em;
				margin: 0;
			}

			.grid-layout {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 3rem;
			}

			@media (max-width: 768px) {
				.grid-layout {
					grid-template-columns: 1fr;
				}
				.calc-container {
					padding: 2rem 1.5rem;
				}
			}

			.input-section h3, .result-section h3 {
				font-size: 1.1rem;
				border-bottom: 1px solid rgba(255, 255, 255, 0.1);
				padding-bottom: 0.5rem;
				margin-bottom: 1.5rem;
				display: flex;
				align-items: center;
				gap: 0.5rem;
			}

			.form-group {
				margin-bottom: 1.5rem;
			}

			.form-group label {
				display: block;
				font-size: 0.85rem;
				color: var(--ink-sub, #a3c2df);
				margin-bottom: 0.5rem;
			}

			.input-wrapper {
				position: relative;
				display: flex;
				align-items: center;
			}

			input[type="number"] {
				width: 100%;
				background: rgba(0, 0, 0, 0.2);
				border: 1px solid rgba(255, 255, 255, 0.1);
				border-radius: 12px;
				padding: 0.8rem 1rem;
				color: #fff;
				font-size: 1.1rem;
				font-family: var(--font-mono, monospace);
				transition: all 0.3s ease;
			}

			input[type="number"]:focus {
				outline: none;
				border-color: #4cc9f0;
				background: rgba(76, 201, 240, 0.05);
				box-shadow: 0 0 0 3px rgba(76, 201, 240, 0.2);
			}

			.unit {
				position: absolute;
				right: 1rem;
				color: var(--gray-label, #8ba3b8);
				font-size: 0.85rem;
				pointer-events: none;
			}

			/* Toggle Switch */
			.toggle-wrapper {
				display: flex;
				align-items: center;
				justify-content: space-between;
				background: rgba(0, 0, 0, 0.2);
				border: 1px solid rgba(255, 255, 255, 0.1);
				border-radius: 12px;
				padding: 0.8rem 1rem;
				cursor: pointer;
				transition: all 0.3s ease;
			}
			
			.toggle-wrapper:hover {
				background: rgba(255, 255, 255, 0.05);
			}

			.toggle-label {
				font-size: 0.95rem;
				color: var(--ink, #fff);
			}

			.switch {
				position: relative;
				display: inline-block;
				width: 44px;
				height: 24px;
			}

			.switch input { 
				opacity: 0;
				width: 0;
				height: 0;
			}

			.slider {
				position: absolute;
				cursor: pointer;
				top: 0;
				left: 0;
				right: 0;
				bottom: 0;
				background-color: rgba(255, 255, 255, 0.2);
				transition: .4s;
				border-radius: 24px;
			}

			.slider:before {
				position: absolute;
				content: "";
				height: 18px;
				width: 18px;
				left: 3px;
				bottom: 3px;
				background-color: white;
				transition: .4s;
				border-radius: 50%;
			}

			input:checked + .slider {
				background-color: #39e600;
			}

			input:checked + .slider:before {
				transform: translateX(20px);
			}

			/* Results */
			.result-card {
				background: rgba(0, 0, 0, 0.2);
				border-radius: 16px;
				padding: 1.5rem;
				margin-bottom: 1rem;
				border: 1px solid rgba(255, 255, 255, 0.05);
				transition: transform 0.3s ease;
			}

			.result-card:hover {
				transform: translateY(-2px);
				background: rgba(255, 255, 255, 0.02);
			}

			.result-label {
				font-size: 0.85rem;
				color: var(--ink-sub, #a3c2df);
				margin-bottom: 0.5rem;
			}

			.result-value {
				font-size: 2rem;
				font-family: var(--font-display, sans-serif);
				font-weight: 700;
				display: flex;
				align-items: baseline;
				gap: 0.3rem;
			}

			.result-unit {
				font-size: 1rem;
				color: var(--gray-label, #8ba3b8);
				font-weight: 400;
			}

			.highlight-card {
				background: linear-gradient(135deg, rgba(76, 201, 240, 0.1) 0%, rgba(114, 9, 183, 0.1) 100%);
				border-color: rgba(76, 201, 240, 0.3);
				box-shadow: 0 10px 30px rgba(76, 201, 240, 0.1);
			}

			.highlight-card .result-value {
				background: linear-gradient(135deg, #4cc9f0 0%, #a78bfa 100%);
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
			}
		</style>
	</head>
	<body>
		<Header />
		
		<main>
			<div class="calc-container">
				<div class="calc-header">
					<h1 class="calc-title">EV vs ガソリン 比較計算</h1>
					<p class="calc-subtitle">TESLA MODEL Y (JUNIPER) MINIMUM CALCULATOR</p>
				</div>

				<div class="grid-layout">
					<!-- 入力エリア -->
					<div class="input-section">
						<h3>⚡️ EV (Tesla) の設定</h3>
						
						<label class="toggle-wrapper form-group">
							<span class="toggle-label">スーパーチャージャー無料期間中</span>
							<label class="switch">
								<input type="checkbox" id="isFreeCharging">
								<span class="slider"></span>
							</label>
						</label>

						<div class="form-group">
							<label for="chargingSpeed">平均充電スピード</label>
							<div class="input-wrapper">
								<input type="number" id="chargingSpeed" value="60" step="1" min="1">
								<span class="unit">kW</span>
							</div>
							<div style="font-size: 0.75rem; color: var(--gray-label); margin-top: 0.5rem;">※速度に応じた分課金で計算されます(37〜200円/分)</div>
						</div>

						<div class="form-group">
							<label for="efficiency">平均エネルギー (Model Y 基準)</label>
							<div class="input-wrapper">
								<input type="number" id="efficiency" value="150" step="1" min="1">
								<span class="unit">Wh / km</span>
							</div>
						</div>

						<div class="form-group">
							<label for="chargeAmount">今回の充電量</label>
							<div class="input-wrapper">
								<input type="number" id="chargeAmount" value="30" step="1" min="1">
								<span class="unit">kWh</span>
							</div>
						</div>

						<h3 style="margin-top: 2rem;">⛽️ 比較用ガソリン車の設定</h3>
						
						<div class="form-group">
							<label for="gasPrice">ガソリン単価</label>
							<div class="input-wrapper">
								<input type="number" id="gasPrice" value="160" step="1" min="0">
								<span class="unit">円 / L</span>
							</div>
						</div>

						<div class="form-group">
							<label for="gasEfficiency">ガソリン車燃費</label>
							<div class="input-wrapper">
								<input type="number" id="gasEfficiency" value="10" step="0.1" min="0.1">
								<span class="unit">km / L</span>
							</div>
						</div>
					</div>

					<!-- 結果エリア -->
					<div class="result-section">
						<h3>📊 計算結果</h3>

						<div class="result-card">
							<div class="result-label">この充電で走れる距離 (推定)</div>
							<div class="result-value">
								<span id="resDistance">195</span>
								<span class="result-unit">km</span>
							</div>
						</div>

						<div class="result-card">
							<div class="result-label">推定充電時間</div>
							<div class="result-value">
								<span id="resChargeTime">18</span>
								<span class="result-unit">分</span>
							</div>
						</div>

						<div class="result-card">
							<div class="result-label">EV 充電コスト</div>
							<div class="result-value">
								<span id="resEvCost">1,350</span>
								<span class="result-unit">円</span>
							</div>
						</div>

						<div class="result-card">
							<div class="result-label">同距離のガソリンコスト</div>
							<div class="result-value" style="color: #ffb703;">
								<span id="resGasCost">2,210</span>
								<span class="result-unit">円</span>
							</div>
						</div>

						<div class="result-card highlight-card" style="margin-top: 1.5rem;">
							<div class="result-label">✨ ガソリン車よりいくらお得？</div>
							<div class="result-value">
								<span id="resSavings">860</span>
								<span class="result-unit">円 お得</span>
							</div>
						</div>
					</div>
				</div>
			</div>
		</main>

		<script>
			function calculate() {
				// Inputs
				const isFree = document.getElementById('isFreeCharging').checked;
				const chargingSpeed = parseFloat(document.getElementById('chargingSpeed').value) || 60;
				const efficiencyWhKm = parseFloat(document.getElementById('efficiency').value) || 150;
				const chargeAmount = parseFloat(document.getElementById('chargeAmount').value) || 30;
				
				const gasPrice = parseFloat(document.getElementById('gasPrice').value) || 160;
				const gasEfficiency = parseFloat(document.getElementById('gasEfficiency').value) || 10; // avoid div by 0

				// Calculations
				const distance = (chargeAmount * 1000) / efficiencyWhKm;
				
				// Calculate EV Cost based on charging speed tiers
				let ratePerMinute = 0;
				if (chargingSpeed >= 180) {
					ratePerMinute = 200;
				} else if (chargingSpeed >= 100) {
					ratePerMinute = 122;
				} else if (chargingSpeed >= 60) {
					ratePerMinute = 78;
				} else {
					ratePerMinute = 37;
				}
				
				const chargeTimeMinutes = chargingSpeed > 0 ? (chargeAmount / chargingSpeed) * 60 : 0;
				const evCost = isFree ? 0 : chargeTimeMinutes * ratePerMinute;
				
				const gasCost = (distance / gasEfficiency) * gasPrice;
				const savings = gasCost - evCost;

				// Update UI
				document.getElementById('resDistance').textContent = Math.round(distance).toLocaleString();
				document.getElementById('resChargeTime').textContent = Math.round(chargeTimeMinutes).toLocaleString();
				document.getElementById('resEvCost').textContent = Math.round(evCost).toLocaleString();
				document.getElementById('resGasCost').textContent = Math.round(gasCost).toLocaleString();
				
				const resSavingsEl = document.getElementById('resSavings');
				const highlightCard = resSavingsEl.closest('.highlight-card');
				
				if (savings >= 0) {
					resSavingsEl.textContent = Math.round(savings).toLocaleString();
					resSavingsEl.nextElementSibling.textContent = "円 お得";
					highlightCard.style.background = 'linear-gradient(135deg, rgba(76, 201, 240, 0.1) 0%, rgba(114, 9, 183, 0.1) 100%)';
				} else {
					resSavingsEl.textContent = Math.round(Math.abs(savings)).toLocaleString();
					resSavingsEl.nextElementSibling.textContent = "円 割高";
					highlightCard.style.background = 'linear-gradient(135deg, rgba(255, 106, 61, 0.1) 0%, rgba(200, 50, 50, 0.1) 100%)';
				}
			}

			// Add event listeners
			const inputs = document.querySelectorAll('input');
			inputs.forEach(input => {
				input.addEventListener('input', calculate);
				input.addEventListener('change', calculate);
			});

			// Initial calculation
			calculate();
		</script>
	</body>
</html>
