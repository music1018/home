			<!-- CONTACT [-3000m] -->
			<section id="contact" data-depth="-3000" class="reveal">
				<div class="content-wrapper">
					<span class="section-kicker">DEPTH -3000M / ABYSSAL ZONE</span>
					<h2 class="section-title">深海底</h2>
					<p class="contact-desc">
						ここまで潜ってくれた人とは、きっといい仕事ができる。
					</p>
					<div class="contact-links">
						<a href="mailto:riku@example.com">EMAIL</a>
						<a href="https://github.com" target="_blank">GITHUB</a>
