---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import { getCollection } from 'astro:content';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const ticks = Array.from({ length: 31 }, (_, i) => i);
const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title="r - Portfolio" description="名はr。けれど仕事の本質は、いつも水面の下にある。潜水するポート防衛・開拓ポートフォリオ。" />
		<style>
			/* 固有スタイル */
			main {
				margin-right: 84px; /* 右端ダイブメーターの領域確保 */
				position: relative;
				z-index: 2;
			}

			@media (max-width: 720px) {
				main {
					margin-right: 56px;
				}
			}

			/* 各セクションレイアウト */
			section {
				min-height: 100vh;
				padding: 14vh 12vw 14vh 10vw;
				display: flex;
				flex-direction: column;
				justify-content: center;
				align-items: flex-start;
				position: relative;
			}

			@media (max-width: 720px) {
				section {
					padding: 10vh 8vw 10vh 6vw;
				}
			}

			.content-wrapper {
				max-width: 760px;
				width: 100%;
			}

			/* 太陽光レイ */
			.sunlight-ray {
				position: fixed;
				top: 0;
				left: 0;
				right: 0;
				height: 100vh;
				background: radial-gradient(circle at 50% 0%, rgba(255, 255, 255, 0.15) 0%, rgba(255, 255, 255, 0) 70%);
				pointer-events: none;
				z-index: 1;
				opacity: 1;
			}

			/* マリンスノーキャンバス */
			.marine-snow {
				position: fixed;
				top: 0;
				left: 0;
				width: 100vw;
				height: 100vh;
				pointer-events: none;
				z-index: 1;
				opacity: 0;
				transition: opacity 1s ease;
			}

			/* ダイブメーター (固定) */
			.dive-meter {
				position: fixed;
				right: 0;
				top: 0;
				bottom: 0;
				width: 84px;
				z-index: 10;
				display: flex;
				flex-direction: column;
				justify-content: space-between;
				align-items: center;
				padding: 2rem 0;
				border-left: 1px solid var(--gray-border);
				background: rgba(4, 102, 200, 0.05);
				backdrop-filter: blur(4px);
			}

			@media (max-width: 720px) {
				.dive-meter {
					width: 56px;
				}
			}

			.meter-ticks {
				position: absolute;
				top: 15%;
				bottom: 15%;
				left: 0;
				width: 100%;
				display: flex;
				flex-direction: column;
				justify-content: space-between;
				pointer-events: none;
			}

			.tick {
				height: 1px;
				background-color: var(--gray-border);
				width: 12px;
				align-self: flex-start;
				transition: width 0.2s ease;
			}

			.tick.major {
				width: 24px;
				background-color: var(--gray-label);
			}

			@media (max-width: 720px) {
				.tick {
					width: 8px;
				}
				.tick.major {
					width: 16px;
				}
			}

			/* 発光ドットマーカー */
			.meter-marker {
				position: absolute;
				left: -5px;
				top: 15%;
				width: 9px;
				height: 9px;
				background-color: var(--ink);
				border-radius: 50%;
				box-shadow: 0 0 10px 3px rgba(234, 241, 248, 0.8);
				transform: translateY(-50%);
				transition: top 0.1s linear;
			}

			.meter-display {
				font-family: var(--font-mono);
				font-size: 11px;
				letter-spacing: 0.2em;
				color: var(--gray-label);
				writing-mode: vertical-rl;
				text-orientation: mixed;
				display: flex;
				flex-direction: column;
				gap: 1rem;
				align-items: center;
			}

			.meter-value {
				color: var(--ink);
				font-weight: 500;
			}

			/* タイポグラフィ修飾 */
			.section-kicker {
				font-family: var(--font-mono);
				font-size: 11px;
				letter-spacing: 0.3em;
				color: var(--gray-label);
				text-transform: uppercase;
				margin-bottom: 1rem;
				display: block;
			}

			.section-title {
				font-size: clamp(26px, 3.4vw, 38px);
				letter-spacing: 0.06em;
				margin-bottom: 2rem;
				font-weight: 600;
			}

			/* 各セクション固有デザイン */
			/* Sky */
			.sky-content {
				text-align: left;
			}
			.sky-title {
				font-size: clamp(32px, 5vw, 64px);
				font-weight: 800;
				margin-bottom: 1.5rem;
			}
			.sky-desc {
				color: var(--ink-sub);
			}

			/* Hero */
			.hero-title {
				font-size: clamp(44px, 8vw, 104px);
				font-weight: 800;
				letter-spacing: 0.04em;
				line-height: 1.2;
				margin-bottom: 1.5rem;
			}
			.hero-sub {
				font-family: var(--font-mono);
				font-size: clamp(15px, 1.6vw, 20px);
				letter-spacing: 0.55em;
				color: var(--ink-sub);
				text-transform: uppercase;
				display: block;
				margin-bottom: 3rem;
			}

			/* DIVE誘導アニメーション */
			.dive-indicator {
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 1rem;
				margin-top: 2rem;
			}
			.dive-line {
				width: 1px;
				height: 80px;
				background: linear-gradient(to bottom, var(--ink), transparent);
				position: relative;
				overflow: hidden;
			}
			.dive-dot {
				position: absolute;
				top: 0;
				left: -2px;
				width: 5px;
				height: 5px;
				background-color: var(--ink);
				border-radius: 50%;
				animation: diveDrop 2s infinite cubic-bezier(0.4, 0, 1, 1);
				box-shadow: 0 0 8px var(--ink);
			}

			@keyframes diveDrop {
				0% { top: 0; opacity: 1; }
				80% { opacity: 1; }
				100% { top: 80px; opacity: 0; }
			}

			/* About */
			.profile-text {
				color: var(--ink-body);
			}

			/* Skills - 3地層構成 */
			.skills-grid {
				display: grid;
				grid-template-columns: 1fr;
				gap: 3rem;
				width: 100%;
			}
			.skill-layer {
				border-left: 2px solid var(--gray-border);
				padding-left: 1.5rem;
			}
			.layer-title {
				font-family: var(--font-display);
				font-size: 20px;
				color: var(--ink);
				margin-bottom: 1rem;
				display: flex;
				align-items: center;
				gap: 0.75rem;
			}
			.layer-depth {
				font-family: var(--font-mono);
				font-size: 11px;
				color: var(--gray-label);
			}
			.layer-tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.75rem;
				margin-top: 1rem;
			}
			.tag {
				font-family: var(--font-mono);
				font-size: 11px;
				letter-spacing: 0.1em;
				padding: 0.25rem 0.75rem;
				border: 1px solid var(--gray-border);
				border-radius: 20px;
				color: var(--ink-sub);
			}

			/* Works */
			.works-list {
				display: grid;
				grid-template-columns: repeat(2, 1fr);
				gap: 1.5rem;
				width: 100%;
			}
			@media (max-width: 768px) {
				.works-list {
					grid-template-columns: 1fr;
				}
			}
			.work-item {
				background: rgba(255, 255, 255, 0.02);
				border: 1px solid rgba(255, 255, 255, 0.06);
				border-radius: 16px;
				padding: 1.5rem;
				display: flex;
				flex-direction: column;
				justify-content: space-between;
				transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
				position: relative;
				overflow: hidden;
				gap: 1rem;
				border-bottom: 1px solid rgba(255, 255, 255, 0.06);
			}
			.work-item:hover {
				transform: translateY(-5px);
				background: rgba(255, 255, 255, 0.04);
				border-color: rgba(255, 255, 255, 0.25);
				box-shadow: 0 15px 35px rgba(0, 0, 0, 0.5);
			}
			.work-item[data-glow="password"]:hover {
				border-color: #4cc9f0 !important;
				box-shadow: 0 15px 30px rgba(76, 201, 240, 0.12), 0 0 15px rgba(76, 201, 240, 0.05);
			}
			.work-item[data-glow="sound"]:hover {
				border-color: #7209b7 !important;
				box-shadow: 0 15px 30px rgba(114, 9, 183, 0.12), 0 0 15px rgba(114, 9, 183, 0.05);
			}
			.work-item[data-glow="pressure"]:hover {
				border-color: #00f5d4 !important;
				box-shadow: 0 15px 30px rgba(0, 245, 212, 0.12), 0 0 15px rgba(0, 245, 212, 0.05);
			}
			.work-item[data-glow="mars"]:hover {
				border-color: #ff6a3d !important;
				box-shadow: 0 15px 30px rgba(255, 106, 61, 0.12), 0 0 15px rgba(255, 106, 61, 0.05);
			}
			.work-item[data-glow="othello"]:hover {
				border-color: #39e600 !important;
				box-shadow: 0 15px 30px rgba(57, 230, 0, 0.12), 0 0 15px rgba(57, 230, 0, 0.05);
			}
			.work-item[data-glow="hack"]:hover {
				border-color: #39e600 !important;
				box-shadow: 0 15px 30px rgba(57, 230, 0, 0.15), 0 0 15px rgba(57, 230, 0, 0.08);
			}
			.work-item[data-glow="blog"]:hover {
				border-color: #4cc9f0 !important;
				box-shadow: 0 15px 30px rgba(76, 201, 240, 0.12);
			}
			.work-item[data-glow="models"]:hover {
				border-color: #a78bfa !important;
				box-shadow: 0 15px 30px rgba(167, 139, 250, 0.18), 0 0 15px rgba(167, 139, 250, 0.08);
			}
			.work-header {
				display: flex;
				flex-direction: column;
				align-items: flex-start;
				gap: 0.5rem;
			}
			.work-title-wrap {
				display: flex;
				align-items: center;
				gap: 0.75rem;
				width: 100%;
			}
			.work-icon {
				width: 28px;
				height: 28px;
				object-fit: contain;
				filter: drop-shadow(0 0 5px rgba(255, 255, 255, 0.1));
				transition: transform 0.3s ease;
			}
			.work-item:hover .work-icon {
				transform: rotate(6deg) scale(1.08);
			}
			.work-title {
				font-size: 1.1rem;
				font-family: var(--font-display);
				font-weight: 700;
				margin: 0;
			}
			.work-title a {
				color: var(--ink);
				text-decoration: none !important;
				display: flex;
				align-items: center;
				width: 100%;
			}
			.work-tech {
				font-family: var(--font-mono);
				font-size: 10px;
				color: var(--gray-label);
				letter-spacing: 0.02em;
			}
			.work-desc {
				font-size: 0.82rem;
				line-height: 1.5;
				color: var(--ink-body);
				margin: 0;
			}

			/* Contact */
			.contact-desc {
				font-size: 18px;
				font-family: var(--font-display);
				margin-bottom: 3rem;
				color: var(--ink);
			}
			.contact-links {
				display: flex;
				gap: 2rem;
				font-family: var(--font-mono);
				font-size: 14px;
			}

			@media (prefers-reduced-motion: reduce) {
				.dive-dot {
					animation: none;
					display: none;
				}
			}
		</style>
	</head>
	<body>
		<Header />

		<!-- 太陽光レイ (海面〜浅瀬) -->
		<div class="sunlight-ray" id="sunlightRay"></div>

		<!-- マリンスノー (中深層〜深海底) -->
		<canvas class="marine-snow" id="marineSnowCanvas"></canvas>

		<!-- ダイブメーター -->
		<aside class="dive-meter" aria-hidden="true">
			<div class="meter-display">
				<span>SURFACE</span>
				<span class="meter-value" id="depthValue">0000M</span>
				<span>DEPTH</span>
			</div>
			
			<div class="meter-ticks">
				{ticks.map((i) => (
					<div class={`tick ${i % 5 === 0 ? 'major' : ''}`}></div>
				))}
				<!-- 位置マーカー -->
				<div class="meter-marker" id="meterMarker"></div>
			</div>

			<div class="meter-display">
				<span>DIVE</span>
			</div>
		</aside>

		<main>
			<!-- SKY (上方向の隠しページ) [+120m] -->
			<section id="sky" data-depth="120" class="reveal">
				<div class="content-wrapper sky-content">
					<span class="section-kicker">ALTITUDE +120M / SKY</span>
					<h2 class="sky-title">見上げれば、まだ光が残っている。</h2>
					<p class="sky-desc">
						水面を越えて、はるか上空へ。ここには遮るもののない風と光がある。<br>
						しかし、私の本質的な探求は、常にここから潜り始めた先の、深い場所にある。
					</p>
				</div>
			</section>

			<!-- HERO [0m] -->
			<section id="hero" data-depth="0">
				<div class="content-wrapper">
					<span class="section-kicker">DEPTH 0M / SURFACE</span>
					<h1 class="hero-title">r — 本質は、水面の下に。</h1>
					<span class="hero-sub">UNDERWATER EXPLORATION</span>
					
					<div class="dive-indicator">
						<span style="font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.2em; color: var(--gray-label);">SCROLL TO DIVE</span>
						<div class="dive-line">
							<div class="dive-dot"></div>
						</div>
					</div>
				</div>
			</section>

			<!-- ABOUT [-200m] -->
			<section id="about" data-depth="-200" class="reveal">
				<div class="content-wrapper">
					<span class="section-kicker">DEPTH -200M / PHOTIC ZONE</span>
					<h2 class="section-title">有光層</h2>
					<div class="profile-text">
						<p>
							光が十分に届き、多様な生命が息づく海面直下。私たちは目に見えるデザインや、手触りのあるインターフェースを通して、最初にこの層に触れます。
						</p>
						<p>
							私は、ユーザーが快適に呼吸し、迷わず探索できる美しく直感的なフロントエンド開発を得意としています。しかし、本当に強固でスケールするシステムを構築するには、光の届かないより深い層への理解が不可欠です。
						</p>
					</div>
				</div>
			</section>

			<!-- SKILLS [-650m] -->
			<section id="skills" data-depth="-650" class="reveal">
				<div class="content-wrapper">
					<span class="section-kicker">DEPTH -650M / MESOPELAGIC</span>
					<h2 class="section-title">中深層</h2>
					
					<div class="skills-grid">
						<!-- 表層 -->
						<div class="skill-layer">
							<div class="layer-title">
								<span>表層（UI / Interaction）</span>
								<span class="layer-depth">0m – 200m</span>
							</div>
							<p>視覚的な美しさと、滑らかなユーザビリティの融合。感覚に直接響くデザイン設計。</p>
							<div class="layer-tags">
								<span class="tag">HTML5</span>
								<span class="tag">CSS3 (Vanilla)</span>
								<span class="tag">JavaScript (ES6+)</span>
								<span class="tag">Responsive Design</span>
							</div>
						</div>

						<!-- 中層 -->
						<div class="skill-layer">
							<div class="layer-title">
								<span>中層（Logic / Architecture）</span>
								<span class="layer-depth">200m – 1000m</span>
							</div>
							<p>堅牢なコンポーネント設計と、再利用可能なロジック。予測可能性を重視した設計。</p>
							<div class="layer-tags">
								<span class="tag">Astro</span>
								<span class="tag">React</span>
								<span class="tag">TypeScript</span>
								<span class="tag">Node.js</span>
							</div>
						</div>

						<!-- 深層 -->
						<div class="skill-layer">
							<div class="layer-title">
								<span>深層（Data / Infrastructure）</span>
								<span class="layer-depth">1000m – 3000m</span>
							</div>
							<p>データ設計とインフラ基盤。スケーラブルな構造を深部から支える。</p>
							<div class="layer-tags">
								<span class="tag">Firebase / Firestore</span>
								<span class="tag">Cloudflare Pages</span>
								<span class="tag">GitHub Actions</span>
							</div>
						</div>
					</div>
				</div>
			</section>

			<!-- WORKS [-1200m] -->
			<section id="works" data-depth="-1200" class="reveal">
				<div class="content-wrapper">
					<span class="section-kicker">DEPTH -1200M / BATHYPELAGIC</span>
					<h2 class="section-title">深海の作品群</h2>
					<div class="works-list">
						<div class="work-item" data-glow="copycraft">
							<div class="work-header">
								<div class="work-title-wrap">
									<img src="/copycraft/favicon.svg" alt="" class="work-icon" />
									<h3 class="work-title"><a href="/copycraft/">AI CopyCraft ↗</a></h3>
								</div>
								<span class="work-tech">HTML5 / Vanilla CSS / Gemini API</span>
							</div>
							<p class="work-desc">ブログ・SNS向けの下書きテキストを直感的なUIで瞬時に自動生成する高機能AIアシスタントツール。</p>
						</div>

						<div class="work-item" data-glow="password">
							<div class="work-header">
								<div class="work-title-wrap">
									<img src="/password/favicon.svg" alt="" class="work-icon" />
									<h3 class="work-title"><a href="/password/">次世代パスワード作成ツール ↗</a></h3>
								</div>
								<span class="work-tech">HTML5 / CSS3 / JavaScript (Crypto API)</span>
							</div>
							<p class="work-desc">堅牢なランダム生成と、人間が記憶可能な単語ベース生成（XKCD方式）を兼ね備えた、完全ローカル完結型の近未来的セキュリティツール。</p>
						</div>

						<div class="work-item" data-glow="sound">
							<div class="work-header">
								<div class="work-title-wrap">
									<img src="/sound/favicon.svg" alt="" class="work-icon" />
									<h3 class="work-title"><a href="/sound/">深海アンビエント音源 ↗</a></h3>
								</div>
								<span class="work-tech">HTML5 / Web Audio API / CSS Animation</span>
							</div>
							<p class="work-desc">ソナー音、泡の音、海底地響き、波音をブラウザ上で動的に波形合成してブレンド再生する、完全オフライン型の環境音ジェネレーター。</p>
						</div>

						<div class="work-item" data-glow="pressure">
							<div class="work-header">
								<div class="work-title-wrap">
									<img src="/pressure/favicon.svg" alt="" class="work-icon" />
									<h3 class="work-title"><a href="/pressure/">水深・水圧シミュレーター ↗</a></h3>
								</div>
								<span class="work-tech">HTML5 / CSS3 / JavaScript (Exponential Interpolation)</span>
							</div>
							<p class="work-desc">チャレンジャー海淵（-10,928m）まで潜るビジュアル潜水艇。深度に応じた水圧・温度・光量と、深海生物の生態データをリアルタイムに可視化。</p>
						</div>

						<div class="work-item" data-glow="mars">
							<div class="work-header">
								<div class="work-title-wrap">
									<img src="/mars/favicon.svg" alt="" class="work-icon" />
									<h3 class="work-title"><a href="/mars/">火星移住シミュレーター ↗</a></h3>
								</div>
								<span class="work-tech">HTML5 / CSS3 / JavaScript (deterministic Sol-based engine)</span>
							</div>
							<p class="work-desc">火星に居住区を構築し、酸素、水、食料、エネルギー、資金を管理して人口100人の自立都市を目指すサバイバル資源管理シミュレーションゲーム。</p>
						</div>

						<div class="work-item" data-glow="othello">
							<div class="work-header">
								<div class="work-title-wrap">
									<img src="/othello/favicon.svg" alt="" class="work-icon" />
									<h3 class="work-title"><a href="/othello/">最強オセロAIシミュレーター ↗</a></h3>
								</div>
								<span class="work-tech">HTML5 / CSS3 / JavaScript (Minimax Search with Alpha-Beta pruning)</span>
							</div>
							<p class="work-desc">ルールベースの最強AIアルゴリズムを対戦・可視化させ、戦略パラメータをリアルタイム調整できる高機能オセロシミュレーター。</p>
						</div>

