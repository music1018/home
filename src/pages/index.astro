		<!-- スクロール制御＆演出用スクリプト -->
		<script>
			// 深度カラーのカラーパレット定義
			const stops = [
				{ p: 0.00, r: 4,   g: 102, b: 200 }, // #0466C8
				{ p: 0.14, r: 3,   g: 83,  b: 164 }, // #0353A4
				{ p: 0.30, r: 2,   g: 62,  b: 125 }, // #023E7D
				{ p: 0.50, r: 0,   g: 40,  b: 85 },  // #002855
				{ p: 0.72, r: 0,   g: 24,  b: 69 },  // #001845
				{ p: 1.00, r: 0,   g: 18,  b: 51 }   // #001233
			];

			// RGB線形補間
			function interpolateColor(percent) {
				if (percent <= 0) return `rgb(${stops[0].r}, ${stops[0].g}, ${stops[0].b})`;
				if (percent >= 1) return `rgb(${stops[stops.length-1].r}, ${stops[stops.length-1].g}, ${stops[stops.length-1].b})`;
				
				let i = 0;
				for (; i < stops.length - 1; i++) {
					if (percent >= stops[i].p && percent <= stops[i+1].p) {
						break;
					}
				}
				
				const s1 = stops[i];
				const s2 = stops[i+1];
				
				const range = s2.p - s1.p;
				const factor = (percent - s1.p) / range;
				
				const r = Math.round(s1.r + (s2.r - s1.r) * factor);
				const g = Math.round(s1.g + (s2.g - s1.g) * factor);
				const b = Math.round(s1.b + (s2.b - s1.b) * factor);
				
				return `rgb(${r}, ${g}, ${b})`;
			}

			// スクロール制御
			let scrollY = 0;
			let documentHeight = 0;
			let windowHeight = 0;
			let prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

			let depthValueEl: HTMLElement | null = null;
			let meterMarkerEl: HTMLElement | null = null;
			let sunlightRayEl: HTMLElement | null = null;
			let canvas: HTMLCanvasElement | null = null;
			let ctx: CanvasRenderingContext2D | null = null;

			function updateMetrics() {
				documentHeight = document.documentElement.scrollHeight;
				windowHeight = window.innerHeight;
			}

			let handleIndexScroll: (() => void) | null = null;
			let revealObserver: IntersectionObserver | null = null;
			let animationFrameId: number | null = null;
			let resizeObserver: ResizeObserver | null = null;

			function setupIndexPage() {
				// 毎回最新のDOM要素を取得し直す (View Transitions対策)
				depthValueEl = document.getElementById('depthValue');
				meterMarkerEl = document.getElementById('meterMarker');
				sunlightRayEl = document.getElementById('sunlightRay');
				canvas = document.getElementById('marineSnowCanvas') as HTMLCanvasElement | null;
				ctx = canvas ? canvas.getContext('2d') : null;

				// 強制的に前ページのクラス・インラインスタイルをリセット
				document.body.classList.remove('submarine-body');
				document.body.style.removeProperty('--bg-deep');
				document.body.style.removeProperty('background-color');

				updateMetrics();
				onScroll();
				initRevealAndSnow();

				if (handleIndexScroll) {
					window.removeEventListener('scroll', handleIndexScroll);
				}

				let ticking = false;
				handleIndexScroll = () => {
					if (!ticking) {
						window.requestAnimationFrame(() => {
							onScroll();
							ticking = false;
						});
						ticking = true;
					}
				};

				window.addEventListener('scroll', handleIndexScroll, { passive: true });

				// ドキュメント高さの動的変化を監視
				if (resizeObserver) {
					resizeObserver.disconnect();
				}
				resizeObserver = new ResizeObserver(() => {
					updateMetrics();
					onScroll();
				});
				resizeObserver.observe(document.body);
			}

			function cleanupIndexPage() {
				if (handleIndexScroll) {
					window.removeEventListener('scroll', handleIndexScroll);
					handleIndexScroll = null;
				}
				if (resizeObserver) {
					resizeObserver.disconnect();
					resizeObserver = null;
				}
				cleanupRevealAndSnow();
			}

			document.addEventListener('astro:page-load', () => {
				if (document.getElementById('hero')) {
					setupIndexPage();
				} else {
					cleanupIndexPage();
				}
			});

			document.addEventListener('astro:before-preparation', () => {
				cleanupIndexPage();
			});

			window.addEventListener('resize', () => {
				updateMetrics();
				if (canvas) {
					canvas.width = window.innerWidth;
					canvas.height = window.innerHeight;
				}
			});

			function onScroll() {
				scrollY = window.scrollY;
				documentHeight = document.documentElement.scrollHeight;
				let maxScroll = documentHeight - windowHeight;
				if (maxScroll <= 0) maxScroll = 1;

				// 全体のスクロールパーセント (Skyを含む)
				let percent = scrollY / maxScroll;
				percent = Math.max(0, Math.min(1, percent));

				// 1. 背景色の変更
				const currentBg = interpolateColor(percent);
				document.body.style.setProperty('--bg-deep', currentBg);

				// 2. ダイブメーター水深の数値計算 (Skyセクションより上が0以上、下がマイナス方向)
				// 全体のスクロール可能領域に対する各セクションの位置からマッピング
				// 0m (Hero) のスクロール位置を取得
				const heroEl = document.getElementById('hero');
				const contactEl = document.getElementById('contact');
				
				if (heroEl && contactEl) {
					const heroTop = heroEl.offsetTop;
					const contactTop = contactEl.offsetTop;
					const activeRange = contactTop - heroTop;
					
					let relativeScroll = scrollY - heroTop;
					let divePercent = relativeScroll / activeRange;
					divePercent = Math.max(0, Math.min(1, divePercent));
					
					// 水深 0 〜 3000m に変換
					const currentDepth = Math.round(divePercent * 3000);
					
					// 上空（Sky）領域にいる場合、高度表示
					if (depthValueEl) {
						if (scrollY < heroTop) {
							const skyPercent = (heroTop - scrollY) / heroTop;
							const altitude = Math.round(skyPercent * 120);
							depthValueEl.textContent = `+${altitude.toString().padStart(3, '0')}M`;
						} else {
							depthValueEl.textContent = `-${currentDepth.toString().padStart(4, '0')}M`;
						}
					}

					// マーカーの縦位置変更 (メーター領域の15%から85%の間で移動)
					if (meterMarkerEl) {
						const markerTop = 15 + (percent * 70);
						meterMarkerEl.style.top = `${markerTop}%`;
					}
					
					// 3. 太陽光レイの不透明度（表層0.14付近でフェードアウト）
					if (sunlightRayEl) {
						if (percent < 0.14) {
							sunlightRayEl.style.opacity = (1 - (percent / 0.14)).toString();
							sunlightRayEl.style.display = 'block';
						} else {
							sunlightRayEl.style.opacity = '0';
							sunlightRayEl.style.display = 'none';
						}
					}

					// 4. マリンスノーの不透明度（およそ-500m / スクロール率0.17以上でフェードイン）
					if (canvas) {
						if (percent > 0.17) {
							canvas.style.opacity = Math.min(1, (percent - 0.17) * 4).toString();
						} else {
							canvas.style.opacity = '0';
						}
					}
				}
			}

			function initRevealAndSnow() {
				cleanupRevealAndSnow();

				// 5. リビールアニメーションのIntersectionObserver
				const revealElements = document.querySelectorAll('.reveal');
				const observerOptions = {
					root: null,
					threshold: 0.1,
					rootMargin: '0px 0px -50px 0px'
				};

				revealObserver = new IntersectionObserver((entries, observer) => {
					entries.forEach(entry => {
						if (entry.isIntersecting) {
							entry.target.classList.add('active');
							observer.unobserve(entry.target);
						}
					});
				}, observerOptions);

				if (!prefersReducedMotion) {
					revealElements.forEach(el => revealObserver.observe(el));
				} else {
					// モーション軽減時はすべて最初から表示
					revealElements.forEach(el => el.classList.add('active'));
				}

				// 6. マリンスノー Canvasアニメーション
				if (canvas && ctx && !prefersReducedMotion) {
					canvas.width = window.innerWidth;
					canvas.height = window.innerHeight;

					const numParticles = 90;
					const particles: any[] = [];

					for (let i = 0; i < numParticles; i++) {
						particles.push({
							x: Math.random() * canvas.width,
							y: Math.random() * canvas.height,
							r: Math.random() * 2 + 0.5, // 粒子サイズ
							d: Math.random() * numParticles, // 揺らぎの度合い
							speedY: Math.random() * 0.5 + 0.2, // 降下速度
							speedX: Math.random() * 0.2 - 0.1 // 横揺れ
						});
					}

					let angle = 0;
					function drawParticles() {
						if (!ctx || !canvas) return;
						ctx.clearRect(0, 0, canvas.width, canvas.height);
						ctx.fillStyle = 'rgba(234, 241, 248, 0.4)';
						ctx.beginPath();
						
						for (let i = 0; i < numParticles; i++) {
							const p = particles[i];
							ctx.moveTo(p.x, p.y);
							ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2, true);

							// 位置のアップデート
							p.y += p.speedY;
							p.x += Math.sin(angle + p.d) * 0.3 + p.speedX;

							// 画面外に出た粒子を上部に戻す
							if (p.y > canvas.height) {
								particles[i] = {
									x: Math.random() * canvas.width,
									y: -10,
									r: p.r,
									d: p.d,
									speedY: p.speedY,
									speedX: p.speedX
								};
							}
						}
						ctx.fill();
						angle += 0.005;
						animationFrameId = requestAnimationFrame(drawParticles);
					}

					drawParticles();
				}
			}

			function cleanupRevealAndSnow() {
				if (revealObserver) {
					revealObserver.disconnect();
					revealObserver = null;
				}
				if (animationFrameId) {
					cancelAnimationFrame(animationFrameId);
					animationFrameId = null;
				}
			}
		</script>
	</body>
</html>
