			<!-- BLOG [-2200m] -->
			<section id="blog" data-depth="-2200" class="reveal">
				<div class="content-wrapper">
					<span class="section-kicker">DEPTH -2200M / ABYSSOPELAGIC</span>
					<h2 class="section-title">水面下の思考（ブログ）</h2>
					<div class="works-list">
						{posts.map((post) => (
							<div class="work-item">
								<a href={`/blog/${post.id}/`} style="text-decoration: none; display: block;">
