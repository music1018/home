---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={`Blog | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			body {
				background-color: #001233; /* 最深トーン */
				color: var(--ink-body);
			}
			/* マリンスノーキャンバス */
			.marine-snow {
				position: fixed;
				top: 0;
				left: 0;
				width: 100vw;
				height: 100vh;
				pointer-events: none;
				z-index: 1;
				opacity: 0.6;
			}
			main {
				width: 100%;
				max-width: 1000px;
				margin: 0 auto;
				padding: 120px 1.5rem 4rem 1.5rem; /* 固定ヘッダー分のパディングトップ */
				position: relative;
				z-index: 2;
			}
			.blog-header {
				margin-bottom: 4rem;
				text-align: center;
			}
			.blog-header h1 {
				font-family: var(--font-display);
				font-size: clamp(32px, 5vw, 54px);
				font-weight: 800;
				letter-spacing: 0.04em;
				margin-bottom: 1rem;
			}
			.blog-header p {
				font-family: var(--font-mono);
				font-size: 12px;
				color: var(--gray-label);
				letter-spacing: 0.3em;
				text-transform: uppercase;
				margin: 0 auto;
			}
			ul {
				display: grid;
				grid-template-columns: repeat(2, 1fr);
				gap: 2.5rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li {
				background: rgba(15, 23, 42, 0.3);
				backdrop-filter: blur(12px);
				-webkit-backdrop-filter: blur(12px);
				border: 1px solid rgba(255, 255, 255, 0.08);
				border-radius: 16px;
				overflow: hidden;
				transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.3s ease;
			}
			ul li:hover {
				transform: translateY(-6px);
				border-color: rgba(255, 255, 255, 0.2);
			}
			ul li a {
				display: block;
				text-decoration: none;
				color: inherit;
				height: 100%;
			}
			.card-image {
				width: 100%;
				height: 240px;
				overflow: hidden;
				border-bottom: 1px solid rgba(255, 255, 255, 0.08);
			}
			.card-image img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				transition: transform 0.5s ease;
			}
			ul li:hover .card-image img {
				transform: scale(1.04);
			}
			.card-content {
				padding: 1.5rem;
				display: flex;
				flex-direction: column;
				gap: 0.75rem;
			}
			.title {
				margin: 0;
				font-family: var(--font-display);
				font-size: 20px;
				color: var(--ink);
				line-height: 1.4;
			}
			.date {
				margin: 0;
				font-family: var(--font-mono);
				font-size: 11px;
				color: var(--gray-label);
				letter-spacing: 0.1em;
			}
			
			/* 最初の記事を目立たせる */
			ul li.featured {
				grid-column: span 2;
			}
			ul li.featured .card-image {
				height: 380px;
			}
			ul li.featured .title {
				font-size: 24px;
			}

			@media (max-width: 768px) {
				ul {
					grid-template-columns: 1fr;
					gap: 1.5rem;
				}
				ul li.featured {
					grid-column: span 1;
				}
				ul li.featured .card-image {
					height: 200px;
				}
				.card-image {
					height: 200px;
				}
				main {
					padding: 2rem 1rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		
		<!-- マリンスノー背景 -->
		<canvas class="marine-snow" id="blogSnowCanvas"></canvas>

		<main>
			<div class="blog-header">
				<h1>水面下の思考</h1>
				<p>Log / Depth -3000M</p>
			</div>
			
			<section>
				<ul>
					{
						posts.map((post, index) => (
							<li class={index === 0 ? 'featured' : ''}>
								<a href={`/blog/${post.id}/`}>
									{post.data.heroImage && (
										<div class="card-image">
											<img width="720" height="360" src={post.data.heroImage} alt="" />
										</div>
									)}
									<div class="card-content">
										<p class="date">
											<FormattedDate date={post.data.pubDate} />
										</p>
										<h4 class="title">{post.data.title}</h4>
									</div>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />

		<!-- マリンスノーの実行スクリプト -->
		<script>
			const canvas = document.getElementById('blogSnowCanvas') as HTMLCanvasElement;
			const ctx = canvas ? canvas.getContext('2d') : null;
			const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

			if (canvas && ctx && !prefersReducedMotion) {
				canvas.width = window.innerWidth;
				canvas.height = window.innerHeight;

				window.addEventListener('resize', () => {
					canvas.width = window.innerWidth;
					canvas.height = window.innerHeight;
				});

				const numParticles = 60;
				const particles = [];

				for (let i = 0; i < numParticles; i++) {
					particles.push({
						x: Math.random() * canvas.width,
						y: Math.random() * canvas.height,
						r: Math.random() * 2 + 0.5,
						d: Math.random() * numParticles,
						speedY: Math.random() * 0.4 + 0.1,
						speedX: Math.random() * 0.2 - 0.1
					});
				}

				let angle = 0;
				function drawParticles() {
					ctx.clearRect(0, 0, canvas.width, canvas.height);
					ctx.fillStyle = 'rgba(234, 241, 248, 0.3)';
					ctx.beginPath();
					
					for (let i = 0; i < numParticles; i++) {
						const p = particles[i];
						ctx.moveTo(p.x, p.y);
						ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2, true);

						p.y += p.speedY;
						p.x += Math.sin(angle + p.d) * 0.25 + p.speedX;

						if (p.y > canvas.height) {
							particles[i] = {
								x: Math.random() * canvas.width,
								y: -10,
								r: p.r,
								d: p.d,
								speedY: p.speedY,
								speedX: p.speedX
							};
						}
					}
					ctx.fill();
					angle += 0.005;
					requestAnimationFrame(drawParticles);
				}

				drawParticles();
			}
		</script>
	</body>
</html>
