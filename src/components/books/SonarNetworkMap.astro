---
import type { CollectionEntry } from 'astro:content';

interface Props {
  books: CollectionEntry<'books'>[];
}

const { books } = Astro.props;

const graphData = {
  nodes: books.map((b) => ({
    id: b.id,
    title: b.data.title,
    author: b.data.author,
    depth: b.data.depth,
    rating: b.data.rating,
    cover: b.data.cover,
    tags: b.data.tags,
    status: b.data.status
  })),
  edges: books.flatMap(b => 
    (b.data.nextReads || []).map(nr => ({
      source: b.id,
      target: nr.targetSlug,
      relation: nr.relation,
      reason: nr.reason
    }))
  )
};
---

<div class="sonar-network-map-view" id="sonarMapView" style="display: none;">
  <div class="network-canvas-container">
    <div class="map-header-bar">
      <div class="map-title">
        <span class="pulse-ring"></span>
        <span>思考の関連マップ</span>
      </div>
      <p class="map-hint">ノード（書籍）ホバーで繋がりを強調 / クリックで詳細が開きます</p>
    </div>

    <div class="svg-wrapper" id="networkMapWrapper">
      <svg id="sonarNetworkSvg" class="network-svg" viewBox="0 0 900 550" preserveAspectRatio="xMidYMid meet">
        <!-- SVG content rendered via JS -->
      </svg>
    </div>
  </div>
</div>

<script is:inline define:vars={{ graphData }}>
  (function() {
    function normalizeSlug(s) {
      return (s || '').replace(/\.md$/, '').toLowerCase();
    }

    window.initSonarMap = function() {
      const svg = document.getElementById('sonarNetworkSvg');
      if (!svg) return;

      const width = 900;
      const height = 550;
      const nodes = graphData.nodes;
      const edges = graphData.edges;

      const nodeCount = nodes.length;
      nodes.forEach((node, i) => {
        const xProgress = (i + 1) / (nodeCount + 1);
        node.x = 120 + xProgress * (width - 240);
        node.y = 250 + (i % 2 === 0 ? -80 : 80) + Math.sin(i) * 20;
      });

      svg.innerHTML = '';

      const defs = document.createElementNS('http://www.w3.org/2000/svg', 'defs');
      defs.innerHTML = `
        <marker id="arrowhead" markerWidth="8" markerHeight="6" refX="28" refY="3" orient="auto">
          <polygon points="0 0, 8 3, 0 6" fill="#38bdf8" opacity="0.6" />
        </marker>
      `;
      svg.appendChild(defs);

      const edgeGroup = document.createElementNS('http://www.w3.org/2000/svg', 'g');
      edgeGroup.setAttribute('class', 'edges-group');

      edges.forEach(edge => {
        const sourceNorm = normalizeSlug(edge.source);
        const targetNorm = normalizeSlug(edge.target);

        const sourceNode = nodes.find(n => normalizeSlug(n.id) === sourceNorm);
        const targetNode = nodes.find(n => normalizeSlug(n.id) === targetNorm);

        if (sourceNode && targetNode) {
          const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
          const dx = targetNode.x - sourceNode.x;
          const dy = targetNode.y - sourceNode.y;
          const cx1 = sourceNode.x + dx * 0.5;
          const cy1 = sourceNode.y;
          const cx2 = sourceNode.x + dx * 0.5;
          const cy2 = targetNode.y;

          const d = `M ${sourceNode.x} ${sourceNode.y} C ${cx1} ${cy1}, ${cx2} ${cy2}, ${targetNode.x} ${targetNode.y}`;
          path.setAttribute('d', d);
          path.setAttribute('stroke', 'rgba(56, 189, 248, 0.3)');
          path.setAttribute('stroke-width', '2');
          path.setAttribute('stroke-dasharray', '5 3');
          path.setAttribute('fill', 'none');
          path.setAttribute('marker-end', 'url(#arrowhead)');
          path.setAttribute('data-source', sourceNorm);
          path.setAttribute('data-target', targetNorm);
          path.setAttribute('class', 'edge-line');

          edgeGroup.appendChild(path);
        }
      });
      svg.appendChild(edgeGroup);

      const nodeGroup = document.createElementNS('http://www.w3.org/2000/svg', 'g');
      nodeGroup.setAttribute('class', 'nodes-group');

      nodes.forEach(node => {
        const normId = normalizeSlug(node.id);
        const g = document.createElementNS('http://www.w3.org/2000/svg', 'g');
        g.setAttribute('class', 'node-item');
        g.setAttribute('transform', `translate(${node.x}, ${node.y})`);
        g.setAttribute('data-open-modal', node.id);
        g.style.cursor = 'pointer';

        const circle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
        circle.setAttribute('r', '16');
        circle.setAttribute('fill', '#1e293b');
        circle.setAttribute('stroke', '#38bdf8');
        circle.setAttribute('stroke-width', '2');

        const text = document.createElementNS('http://www.w3.org/2000/svg', 'text');
        text.setAttribute('text-anchor', 'middle');
        text.setAttribute('dy', '0.3em');
        text.setAttribute('fill', '#ffffff');
        text.setAttribute('font-size', '10');
        text.setAttribute('font-weight', 'bold');
        text.textContent = `-${node.depth}M`;

        const titleText = document.createElementNS('http://www.w3.org/2000/svg', 'text');
        titleText.setAttribute('text-anchor', 'middle');
        titleText.setAttribute('y', '32');
        titleText.setAttribute('fill', '#f1f5f9');
        titleText.setAttribute('font-size', '12');
        titleText.setAttribute('font-weight', 'bold');
        titleText.textContent = node.title;

        g.appendChild(circle);
        g.appendChild(text);
        g.appendChild(titleText);
        nodeGroup.appendChild(g);

        g.addEventListener('mouseenter', () => {
          circle.setAttribute('stroke', '#00ffff');
          circle.setAttribute('r', '20');
          document.querySelectorAll('.edge-line').forEach(line => {
            const src = line.getAttribute('data-source');
            const tgt = line.getAttribute('data-target');
            if (src === normId || tgt === normId) {
              line.setAttribute('stroke', '#38bdf8');
              line.setAttribute('stroke-width', '3');
              line.setAttribute('opacity', '1');
            } else {
              line.setAttribute('opacity', '0.1');
            }
          });
        });

        g.addEventListener('mouseleave', () => {
          circle.setAttribute('stroke', '#38bdf8');
          circle.setAttribute('r', '16');
          document.querySelectorAll('.edge-line').forEach(line => {
            line.setAttribute('stroke', 'rgba(56, 189, 248, 0.3)');
            line.setAttribute('stroke-width', '2');
            line.setAttribute('opacity', '1');
          });
        });
      });

      svg.appendChild(nodeGroup);
    };

    document.addEventListener('astro:page-load', () => {
      if (window.initSonarMap) window.initSonarMap();
    });
    if (document.readyState === 'complete' || document.readyState === 'interactive') {
      window.initSonarMap();
    }
  })();
</script>

<style>
  .sonar-network-map-view {
    width: 100%;
  }

  .network-canvas-container {
    background: rgba(15, 23, 42, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 1.25rem;
  }

  .map-header-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.85rem;
    padding-bottom: 0.65rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .map-title {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: #38bdf8;
    font-size: 0.85rem;
    font-weight: 700;
  }

  .pulse-ring {
    width: 8px;
    height: 8px;
    background: #38bdf8;
    border-radius: 50%;
  }

  .map-hint {
    font-size: 0.75rem;
    color: #94a3b8;
    margin: 0;
  }

  .svg-wrapper {
    width: 100%;
    height: 480px;
    background: #0f172a;
    border-radius: 8px;
    overflow: hidden;
    position: relative;
  }

  .network-svg {
    width: 100%;
    height: 100%;
  }
</style>
