---
---

<div class="submarine-dive-gauge" id="submarineDiveGauge">
  <div class="gauge-ring">
    <span class="pulse-dot"></span>
    <div class="gauge-labels">
      <span class="gauge-title">思考水深</span>
      <span class="gauge-depth-value" id="currentDepthValue">-300M</span>
    </div>
  </div>
  <div class="zone-name-tag" id="currentZoneTag">浅層 (0~500m)</div>
</div>

<script is:inline>
  (function() {
    let handleGaugeScroll = null;

    function setupGauge() {
      if (handleGaugeScroll) {
        window.removeEventListener('scroll', handleGaugeScroll);
      }

      handleGaugeScroll = () => {
        const scrollPx = window.scrollY;
        const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
        if (maxScroll <= 0) return;

        const progress = Math.min(Math.max(scrollPx / maxScroll, 0), 1);
        const currentDepth = Math.round(300 + progress * 2700);

        const valueEl = document.getElementById('currentDepthValue');
        const zoneEl = document.getElementById('currentZoneTag');

        if (valueEl) {
          valueEl.textContent = `-${currentDepth}M`;
        }

        if (zoneEl) {
          if (currentDepth < 800) {
            zoneEl.textContent = '浅層 (0m〜500m)';
            zoneEl.style.color = '#38bdf8';
          } else if (currentDepth < 1800) {
            zoneEl.textContent = '中深層 (500m〜1500m)';
            zoneEl.style.color = '#60a5fa';
          } else {
            zoneEl.textContent = '漸深層 (1500m以上)';
            zoneEl.style.color = '#818cf8';
          }
        }
      };

      window.addEventListener('scroll', handleGaugeScroll, { passive: true });
    }

    function cleanupGauge() {
      if (handleGaugeScroll) {
        window.removeEventListener('scroll', handleGaugeScroll);
        handleGaugeScroll = null;
      }
    }

    document.addEventListener('astro:page-load', () => {
      if (document.getElementById('submarineDiveGauge')) {
        setupGauge();
      } else {
        cleanupGauge();
      }
    });

    document.addEventListener('astro:before-preparation', () => {
      cleanupGauge();
    });
  })();
</script>

<style>
  .submarine-dive-gauge {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    z-index: 50;
    background: rgba(15, 23, 42, 0.85);
    border: 1px solid rgba(56, 189, 248, 0.2);
    border-radius: 9999px;
    padding: 0.45rem 1.1rem;
    backdrop-filter: blur(12px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
    display: flex;
    align-items: center;
    gap: 0.65rem;
    pointer-events: none;
  }

  .gauge-ring {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .pulse-dot {
    width: 7px;
    height: 7px;
    background: #38bdf8;
    border-radius: 50%;
  }

  .gauge-labels {
    display: flex;
    flex-direction: column;
  }

  .gauge-title {
    font-size: 0.6rem;
    font-weight: 700;
    color: #64748b;
  }

  .gauge-depth-value {
    font-size: 0.9rem;
    font-weight: 800;
    color: #38bdf8;
    font-family: monospace;
    line-height: 1;
  }

  .zone-name-tag {
    font-size: 0.65rem;
    font-weight: 600;
    color: #38bdf8;
    padding-left: 0.65rem;
    border-left: 1px solid rgba(255, 255, 255, 0.1);
  }

  @media (max-width: 640px) {
    .submarine-dive-gauge {
      bottom: 1rem;
      right: 1rem;
      padding: 0.35rem 0.75rem;
    }
    .zone-name-tag {
      display: none;
    }
  }
</style>
