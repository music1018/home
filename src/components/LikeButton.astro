---
interface Props {
  slug: string;
}

const { slug } = Astro.props;
---

<div class="like-container" data-slug={slug}>
  <button id={`like-btn-${slug.replace(/[^a-zA-Z0-9]/g, '-')}`} class="like-button" aria-label="スキ！する">
    <svg class="like-icon" viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
      <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
    </svg>
    <span class="like-text">LIKE</span>
    <span class="like-badge" id={`like-count-${slug.replace(/[^a-zA-Z0-9]/g, '-')}`}>0</span>
  </button>
</div>

<style>
  .like-container {
    display: flex;
    justify-content: center;
    margin: 3rem 0;
  }

  .like-button {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.75rem 1.6rem;
    background: rgba(15, 23, 42, 0.7);
    border: 1px solid rgba(236, 72, 153, 0.3);
    border-radius: 9999px;
    color: #f472b6;
    font-family: var(--font-mono, monospace);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    cursor: pointer;
    backdrop-filter: blur(12px);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4), 0 0 15px rgba(236, 72, 153, 0.1);
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    user-select: none;
    outline: none;
    overflow: hidden;
  }

  .like-button:hover {
    transform: translateY(-2px);
    border-color: rgba(236, 72, 153, 0.7);
    box-shadow: 0 6px 25px rgba(0, 0, 0, 0.5), 0 0 25px rgba(236, 72, 153, 0.3);
    background: rgba(24, 24, 47, 0.85);
    color: #f472b6;
  }

  .like-button:active {
    transform: translateY(1px) scale(0.98);
  }

  .like-icon {
    transition: transform 0.25s ease, fill 0.25s ease;
    fill: currentColor;
  }

  .like-button:hover .like-icon {
    transform: scale(1.18);
  }

  .like-text {
    font-size: 0.9rem;
    font-weight: 700;
  }

  .like-badge {
    background: rgba(236, 72, 153, 0.15);
    border: 1px solid rgba(236, 72, 153, 0.3);
    color: #f472b6;
    padding: 0.15rem 0.55rem;
    border-radius: 9999px;
    font-size: 0.85rem;
    font-family: var(--font-mono, monospace);
    min-width: 1.8rem;
    text-align: center;
  }

  /* スタイリッシュな光の粒子パティクル */
  :global(.glow-particle) {
    position: absolute;
    pointer-events: none;
    font-family: var(--font-mono, monospace);
    font-size: 0.85rem;
    font-weight: 700;
    color: #f472b6;
    text-shadow: 0 0 8px rgba(236, 72, 153, 0.8);
    animation: floatGlow 0.75s cubic-bezier(0.215, 0.61, 0.355, 1) forwards;
    z-index: 10;
  }

  @keyframes floatGlow {
    0% {
      opacity: 1;
      transform: translate(0, 0) scale(0.8);
    }
    100% {
      opacity: 0;
      transform: translate(var(--dx, 0px), -45px) scale(1.2);
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.like-container').forEach((container) => {
    const slug = container.dataset.slug;
    if (!slug) return;

    const safeSlug = slug.replace(/[^a-zA-Z0-9]/g, '-');
    const button = container.querySelector<HTMLButtonElement>(`#like-btn-${safeSlug}`);
    const countBadge = container.querySelector<HTMLElement>(`#like-count-${safeSlug}`);

    if (!button || !countBadge) return;

    let currentCount = 0;
    let pendingIncrements = 0;
    let debounceTimer: number | null = null;

    fetch(`/api/likes?slug=${encodeURIComponent(slug)}`)
      .then((res) => res.json())
      .then((data) => {
        if (typeof data.count === 'number') {
          currentCount = data.count;
          countBadge.textContent = currentCount.toString();
        }
      })
      .catch((err) => console.error('Failed to fetch likes', err));

    const sendBatchLikes = () => {
      if (pendingIncrements <= 0) return;
      const amount = pendingIncrements;
      pendingIncrements = 0;

      fetch('/api/likes', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ slug, increment: amount }),
      })
        .then((res) => res.json())
        .then((data) => {
          if (typeof data.count === 'number') {
            currentCount = data.count;
            countBadge.textContent = currentCount.toString();
          }
        })
        .catch((err) => console.error('Failed to update likes', err));
    };

    button.addEventListener('click', (e) => {
      currentCount++;
      pendingIncrements++;
      countBadge.textContent = currentCount.toString();

      // 絵文字を使わない「+1」ネオンパティクル
      const rect = button.getBoundingClientRect();
      const particle = document.createElement('span');
      particle.className = 'glow-particle';
      particle.textContent = '+1';
      const dx = (Math.random() - 0.5) * 40;
      particle.style.setProperty('--dx', `${dx}px`);
      particle.style.left = `${e.clientX - rect.left - 10}px`;
      particle.style.top = `${e.clientY - rect.top - 10}px`;
      button.appendChild(particle);

      setTimeout(() => particle.remove(), 750);

      if (debounceTimer) clearTimeout(debounceTimer);
      debounceTimer = window.setTimeout(sendBatchLikes, 700);
    });
  });
</script>
